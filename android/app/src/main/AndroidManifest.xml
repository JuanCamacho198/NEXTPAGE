<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".NextPageApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="NextPage"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.NextPage">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NextPage.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase OAuth callback deep-link -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="nextpage"
                    android:host="auth"
                    android:pathPrefix="/callback" />

                <!-- Password-reset email link (Supabase resetPasswordForEmail
                     redirectUrl = nextpage://auth/reset-password). The app
                     resolves this cold-start and lands on the forgot screen. -->
                <data
                    android:scheme="nextpage"
                    android:host="auth"
                    android:pathPrefix="/reset-password" />

                <!-- Email-confirmation deep link (Supabase Site URL
                     nextpage://auth/confirm). supabase-kt's handleDeeplinks
                     parses the fragment and imports the signup session. -->
                <data
                    android:scheme="nextpage"
                    android:host="auth"
                    android:pathPrefix="/confirm" />
            </intent-filter>

            <!-- Google Drive OAuth redirect (authorization-code + PKCE).
                 Scheme injected from build.gradle.kts (driveRedirectScheme) —
                 Google's reserved native-app pattern
                 com.googleusercontent.apps.<android-client-id>:/oauth2redirect.
                 Arbitrary custom URI schemes are no longer supported on Android. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="${driveRedirectScheme}"
                    android:pathPrefix="/oauth2redirect" />
            </intent-filter>
        </activity>

        <activity
            android:name=".debug.CrashDetailActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
