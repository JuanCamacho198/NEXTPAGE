                      "name": "Text",
                      "fill": "#dde2f8ff",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "3. La primera ley: Hazlo obvio",
                      "lineHeight": 1.3333333333333333,
                      "textAlignVertical": "middle",
                      "fontFamily": "Inter",
                      "fontSize": 24,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "POVxx",
                  "name": "Container",
                  "width": "fill_container",
                  "layout": "vertical",
                  "padding": [
                    8.324999809265137,
                    0,
                    0.875,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "htmJr",
                      "name": "Text",
                      "fill": "#c2c6d6ff",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "El cambio de comportamiento no se produce en el\nvacío. Está influenciado por el entorno que nos\nrodea. Por eso, la primera ley de la formación de\nhábitos es hacer que las señales sean obvias.",
                      "lineHeight": 1.625,
                      "textAlignVertical": "middle",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "s60cWH",
                  "name": "Container",
                  "width": "fill_container",
                  "layout": "vertical",
                  "children": [
                    {
                      "type": "text",
                      "id": "qebJl",
                      "name": "Text",
                      "fill": "#c2c6d6ff",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Las señales son los desencadenantes que inician\nnuestros hábitos. Cuanto más obvias sean estas\nseñales, más probable será que actuemos.",
                      "lineHeight": 1.625,
                      "textAlignVertical": "middle",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "DcOXw",
                  "name": "Container",
                  "width": "fill_container",
                  "layout": "vertical",
                  "padding": [
                    1.2000000476837158,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "frame",
                      "id": "W81p1",
                      "name": "Overlay",
                      "width": "fill_container",
                      "fill": "#161f3340",
                      "cornerRadius": 4,
                      "layout": "vertical",
                      "padding": [
                        6.75,
                        8,
                        8.5,
                        8
                      ],
                      "children": [
                        {
                          "type": "text",
                          "id": "a203YJ",
                          "name": "Text",
                          "fill": "#dde2f8ff",
                          "content": "No se trata de tener más motivación, sino de\ndiseñar tu entorno para que el buen\ncomportamiento sea casi inevitable.",
                          "lineHeight": 1.625,
                          "textAlignVertical": "middle",
                          "fontFamily": "Inter",
                          "fontSize": 14,
                          "fontWeight": "normal"
                        }
                      ]
                    },
                    {
                      "type": "rectangle",
                      "cornerRadius": 9999,
                      "id": "oEeQO",
                      "layoutPosition": "absolute",
                      "x": -12,
                      "y": 1.2000000476837158,
                      "name": "Highlight Indicator (Blue Line)",
                      "fill": "#adc6ffff",
                      "width": 4,
                      "height": 84.25
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "k3ycK",
                  "name": "Container",
                  "width": "fill_container",
                  "layout": "vertical",
                  "padding": [
                    0,
                    0,
                    0.875,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "cZacO",
                      "name": "Text",
                      "fill": "#c2c6d6ff",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Por ejemplo, si quieres leer más, deja el libro en una\nmesa visible. Si quieres comer saludable, ten comida\nsaludable a la vista. Pequeños cambios en lo obvio\npueden generar grandes cambios en tu vida.",
                      "lineHeight": 1.625,
                      "textAlignVertical": "middle",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            }
          ]
