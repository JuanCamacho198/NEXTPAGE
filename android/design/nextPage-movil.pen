                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "3. La primera ley: Hazlo obvio",
                      "lineHeight": 1.3333333333333333,
                      "textAlignVertical": "middle",
                      "fontFamily": "Inter",
                      "fontSize": 24,
                      "fontWeight": "700"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wqtj3",
                  "name": "Container",
                  "width": "fill_container",
                  "layout": "vertical",
                  "children": [
                    {
                      "type": "text",
                      "id": "YlAAQ",
                      "name": "Text",
                      "fill": "#c2c6d6ff",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "El cambio de comportamiento no se produce en el\nvacío. Está influenciado por el entorno que nos\nrodea. Por eso, la primera ley de la formación de\nhábitos es hacer que las señales sean obvias.",
                      "lineHeight": 1.4285714285714286,
                      "textAlignVertical": "middle",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "K5EhRq",
                  "name": "Container",
                  "width": "fill_container",
                  "layout": "vertical",
                  "children": [
                    {
                      "type": "text",
                      "id": "LuQkw",
                      "name": "Text",
                      "fill": "#c2c6d6ff",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Las señales son los desencadenantes que inician\nnuestros hábitos. Cuanto más obvias sean estas\nseñales, más probable será que actuemos.",
                      "lineHeight": 1.4285714285714286,
                      "textAlignVertical": "middle",
                      "fontFamily": "Inter",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                }
