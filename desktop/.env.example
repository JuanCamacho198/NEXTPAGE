# Google OAuth Configuration
# Get your client ID from Google Cloud Console
# Configure the OAuth client as type "Desktop app" with
# http://127.0.0.1 as an authorized redirect URI (any port is allowed).
# MUST be prefixed with VITE_ so Vite exposes it to the client bundle.
VITE_GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Deep Link Protocol (reserved for future use, NOT used by OAuth)
# The OAuth flow uses loopback redirect (http://127.0.0.1:{port}/) via
# tauri-plugin-oauth, so this variable is reserved for future non-OAuth
# deep links (e.g. opening the app from a browser link to a specific book).
# It should match the protocol registered in tauri.conf.json.
VITE_DEEP_LINK_PROTOCOL=nextpage-desktop

# Supabase Configuration
# Get these from your Supabase project dashboard → Settings → API
# MUST be prefixed with VITE_ so Vite exposes it to the client bundle
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Sentry Configuration (optional)
# Get your DSN from Sentry project settings
SENTRY_DSN=
