# Google OAuth Configuration
# Get your client ID from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Tauri Configuration (for deep link OAuth redirect)
# This should match the protocol registered in tauri.conf.json
VITE_DEEP_LINK_PROTOCOL=nextpage-desktop

# Sentry Configuration (optional)
# Get your DSN from Sentry project settings
SENTRY_DSN=
