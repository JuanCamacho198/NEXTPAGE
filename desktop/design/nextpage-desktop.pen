                  },
                  "layout": "none",
                  "children": [
                    {
                      "type": "frame",
                      "id": "nj84v",
                      "x": 112,
                      "y": 80,
                      "name": "Article - Content Area",
                      "width": 672,
                      "stroke": {
                        "align": "inside",
