---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';

const locale = 'en' as const;
---
<BaseLayout>
  <section
    class="mx-auto flex max-w-6xl flex-col items-center gap-6 px-4 py-20 text-center"
  >
    <h1 class="font-serif text-5xl font-bold text-text-primary">
      {t(locale, 'index.heroTitle')}
    </h1>
    <p class="max-w-2xl text-lg text-text-secondary">
      {t(locale, 'index.heroSubtitle')}
    </p>
    <span
      class="inline-flex items-center rounded-full bg-accent px-6 py-2 font-sans font-semibold text-accent-ink"
    >
      {t(locale, 'index.heroCta')}
    </span>
  </section>
</BaseLayout>
